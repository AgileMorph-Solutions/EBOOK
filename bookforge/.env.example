# =============================================================================
# BookForge environment template — copy to .env and fill with ROTATED keys.
# NEVER commit .env. The keys pasted in chat earlier are compromised: revoke
# them and generate new ones before using this file.
# =============================================================================

# ---- LLM (content generation + vision QA) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model routing
CONTENT_MODEL=claude-opus-4-8
DRAFT_MODEL=claude-haiku-4-5-20251001
VISION_QA_MODEL=claude-opus-4-8

# ---- Image generation ----
# Use ONE primary provider; FAL recommended for Flux 1.1 Pro.
FAL_KEY=
REPLICATE_API_TOKEN=
IDEOGRAM_API_KEY=
IMAGE_PRIMARY_PROVIDER=fal          # fal | replicate
IMAGE_PRIMARY_MODEL=fal-ai/flux-pro/v1.1
IMAGE_TEXT_MODEL=ideogram-v2        # for in-image text (covers, labels)

# ---- Transcription (YouTube / audio) ----
DEEPGRAM_API_KEY=                   # optional; else self-host faster-whisper

# ---- Web grounding (topic-only mode) ----
SEARCH_API_KEY=                     # Tavily / Brave / Serper — optional
SEARCH_PROVIDER=tavily

# ---- Infrastructure ----
DATABASE_URL=postgresql+psycopg://bookforge:bookforge@postgres:5432/bookforge
REDIS_URL=redis://redis:6379/0

# Object storage (S3-compatible; MinIO in dev)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=bookforge
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ---- Guardrails ----
PER_BOOK_BUDGET_USD=50
IMAGE_CANDIDATES_PER_PAGE=2
MAX_FILE_SIZE_MB=80
GROUNDEDNESS_THRESHOLD=1.0          # 1.0 = 100% of retained claims must verify

# ---- Print specs ----
TRIM_WIDTH_IN=8.5
TRIM_HEIGHT_IN=11
BLEED_IN=0.125
TARGET_DPI=300

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
