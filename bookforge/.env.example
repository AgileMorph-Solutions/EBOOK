# =============================================================================
# BookForge environment template — copy to .env and fill with ROTATED keys.
# NEVER commit .env. The keys pasted in chat earlier are compromised: revoke
# them and generate new ones before using this file.
# =============================================================================

# ---- LLM (content generation + vision QA) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model routing
CONTENT_MODEL=claude-opus-4-8
DRAFT_MODEL=claude-haiku-4-5-20251001
VISION_QA_MODEL=claude-opus-4-8
# Tried in order on a MODEL-SPECIFIC failure (not-found/overload/non-credit 400).
# Credits/auth errors are NOT cascaded — they park & auto-resume instead.
CONTENT_MODEL_FALLBACKS=claude-sonnet-4-6,claude-haiku-4-5-20251001

# ---- Image generation ----
IMAGE_PRIMARY_PROVIDER=gemini          # gemini | openai
IMAGE_PRIMARY_MODEL=imagen-4.0-generate-001
IMAGE_ALLOW_PROVIDER_FALLBACK=false  # true = fall back to openai on Imagen failure
IMAGE_REJECT_TEXT_ARTIFACTS=true

# ---- Audio scripts / ElevenLabs TTS ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=bP8FJDHmWVEgXJDitdQd
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TTS_WORKERS=2
# Docker Compose publishes the API on host port 8011 (8011→8000).
API_PUBLIC_BASE_URL=http://localhost:8011
AUDIO_SCRIPT_MAX_ITEMS=100
AUDIO_SCRIPT_ITEM_WORKERS=4
AUDIO_SCRIPT_GENERIC_DEFAULT_WORDS=1000

# ---- Transcription (YouTube / audio) ----
DEEPGRAM_API_KEY=                   # optional; else self-host faster-whisper
# Netscape-format cookies.txt from a logged-in YouTube session, used to work
# around YouTube IP-blocking this server ("Sign in to confirm you're not a
# bot"). Export via a browser extension (e.g. "Get cookies.txt LOCALLY") while
# logged into youtube.com, then place the file on this host and point here.
YT_COOKIES_FILE=

# ---- Web grounding (topic-only mode) ----
SEARCH_API_KEY=                     # Tavily / Brave / Serper — optional
SEARCH_PROVIDER=tavily

# ---- Infrastructure ----
DATABASE_URL=postgresql+psycopg://bookforge:bookforge@postgres:5432/bookforge
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Object storage (S3-compatible; MinIO in dev)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=bookforge
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ---- Guardrails ----
PER_BOOK_BUDGET_USD=50               # hard per-book spend cap; 0 = no cap
MAX_BASE_SECTIONS=0                  # ceiling on distinct base topics; 0 = no ceiling (scales with pages)
IMAGE_CANDIDATES_PER_PAGE=2          # multi-candidate vision scoring when > 1
MAX_FILE_SIZE_MB=80
MAX_SOURCE_SIZE_MB=10
GROUNDEDNESS_THRESHOLD=1.0          # 1.0 = 100% of retained claims must verify

# ---- Resilience / self-heal ----
MAX_JOB_RETRIES=2                    # whole-job retries for transient failures before parking
PROVIDER_RETRY_BACKOFF_S=60,300,900,1800  # backoff between park & auto-resume attempts (last repeats)
RESUME_POLL_INTERVAL_S=60           # how often the background loop scans for parked jobs
MAX_RESUME_ATTEMPTS=3               # cap on restart-driven resumes of one job (crash-loop guard)
HEALTH_PING_TTL_S=60                # cache TTL for the /health provider ping
READINESS_IMAGE_PROBE=metadata      # image readiness: metadata | generate | off
OPERATOR_ALERT_WEBHOOK=             # optional Slack-style webhook for operator alerts

# ---- Print specs ----
TRIM_WIDTH_IN=8.5
TRIM_HEIGHT_IN=11
BLEED_IN=0.125
TARGET_DPI=300

# ---- Auth ----
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=1440                # 24h
SEED_ADMIN_PASSWORD=admin-dev-password
SEED_USER_PASSWORD=user-dev-password

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
