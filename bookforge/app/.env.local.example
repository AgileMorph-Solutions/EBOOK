# Browser-visible API URL (build-time fallback)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Runtime API URL for server-side config route (Docker: set to reachable API host)
# API_URL=http://localhost:8000

# Display metadata for Pipeline Specs (optional — defaults shown in UI)
# TRIM_WIDTH_IN=8.5
# TRIM_HEIGHT_IN=11
# CONTENT_MODEL=claude-opus-5
# DRAFT_MODEL=claude-haiku-4-5-20251001
# IMAGE_PRIMARY_MODEL=imagen-4.0-generate-001
# IMAGE_PRIMARY_PROVIDER=gemini

# For non-localhost deploys, set CORS on the API:
# CORS_ORIGINS=https://your-ui.example.com
