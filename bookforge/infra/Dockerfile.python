# Python pipeline image — shared by api / worker / beat.
# Multi-stage: build deps in a fat layer, copy into a slim runtime.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# System libs: Pillow (jpeg/zlib), Ghostscript + jpegoptim/pngquant for the
# pdftools/compression stage, ffmpeg for ASR fallback.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ghostscript libjpeg62-turbo zlib1g \
    jpegoptim pngquant ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY bookforge ./bookforge

# Non-root runtime
RUN useradd -m forge && chown -R forge /app && mkdir -p /home/forge/artifacts && chown forge /home/forge/artifacts
USER forge

EXPOSE 8000
CMD ["uvicorn", "bookforge.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
